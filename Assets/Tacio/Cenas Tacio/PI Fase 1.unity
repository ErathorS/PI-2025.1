    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: dialogoGlobal
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Jogador: Oi, Dandara. Voc\xEA viu o ataque \xE0s baianas?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Dandara: Vi tudo. Os caras chegaram filmando, rindo, falando que as
        baianas \u201Cadoravam diabo\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: Ningu\xE9m ajudou?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Dandara: O povo ficou com medo. Quando chutaram o tabuleiro, fui ajudar
        a juntar. Uma caixa caiu na escadaria, outra o rapaz do armaz\xE9m pegou
        pra guardar."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Jogador: Ent\xE3o uma est\xE1 segura?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Dandara: T\xE1 sim. As outras talvez estejam no beco."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: 'Jogador: Valeu pela ajuda.'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Dandara: Escreve direito, viu? Isso foi racismo, n\xE3o \u201Cbagun\xE7a\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[8]
      value: "Dandara: De nada, mo\xE7o. S\xF3 escreve direito, viu? O que aconteceu
        aqui foi racismo. N\xE3o deixa isso parecer s\xF3 \u201Cbagun\xE7a de rua\u201D,
        n\xE3o. A gente t\xE1 cansado de ver nossa f\xE9 e nossa cultura sendo tratada
        assim."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[9]
      value: "Dandara: De nada, mo\xE7o. S\xF3 escreve direito, viu? O que aconteceu
        aqui foi racismo. N\xE3o deixa isso parecer s\xF3 \u201Cbagun\xE7a de rua\u201D,
        n\xE3o. A gente t\xE1 cansado de ver nossa f\xE9 e nossa cultura sendo tratada
        assim."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[10]
      value: "Dandara: De nada, mo\xE7o. S\xF3 escreve direito, viu? O que aconteceu
        aqui foi racismo. N\xE3o deixa isso parecer s\xF3 \u201Cbagun\xE7a de rua\u201D,
        n\xE3o. A gente t\xE1 cansado de ver nossa f\xE9 e nossa cultura sendo tratada
        assim."
      objectReference: {fileID: 0}
