      value: 89.014
      objectReference: {fileID: 0}
    - target: {fileID: 1943167801460269989, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2258125217435752391, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: sceneViewId
      value: 37
      objectReference: {fileID: 0}
    - target: {fileID: 2948380906371488001, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Name
      value: NPC 3
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: 'Jogador: O senhor viu o que aconteceu com as baianas?'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Raimundo: Vi sim. Os rapazes chegaram debochando, dizendo que o acaraj\xE9
        \u201Csujava o turismo\u201D. Depois chutaram o tabuleiro."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: 'Jogador: E as caixas?'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Raimundo: Tr\xEAs se espalharam: uma ficou no coreto, outra perto do
        casar\xE3o azul, e a terceira um menino levou pra rua de tr\xE1s."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Jogador: Ent\xE3o ainda podem estar por perto?"
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: 'Raimundo: Podem, mas corram antes que estrague.'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: 'Jogador: Obrigado.'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Raimundo: E escreva direito: aquilo foi \xF3dio."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[8]
      value: "Jogador: \xC9 por isso que estamos aqui. Precisamos contar a verdade."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[9]
      value: 'Paulinha: Faz isso mesmo. Porque se eu, que sou de fora, fiquei abalada,
        imagina quem vive isso todo dia.'
      objectReference: {fileID: 0}
    - target: {fileID: 8654470778002267675, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Size.x
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8654470778002267675, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Size.z
      value: 7
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
