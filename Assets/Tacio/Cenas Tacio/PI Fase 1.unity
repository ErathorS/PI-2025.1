    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: 'Jogador: Boa tarde, seu Zeca. O senhor viu o que rolou aqui no Largo?'
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Seu Zeca: Vi sim, meu filho. Tava varrendo quando uns tr\xEAs rapazes
        chegaram zombando das baianas, falando besteira do acaraj\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: 'Jogador: Que tipo de besteira?'
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Seu Zeca: Chamaram de \u201Ccomida de macumba\u201D, \u201Cfeiti\xE7o
        pra turista\u201D. Dona Cida tentou conversar, mas um deles chutou o tabuleiro."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: 'Jogador: E as caixas de ingredientes?'
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Seu Zeca: Ca\xEDram no ch\xE3o na confus\xE3o. Vi dois meninos pegando
        algumas e correndo pro beco perto da igreja."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: "Jogador: Voc\xEA acha que esconderam?"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Seu Zeca: Pode ser. Aqui o povo se vira como pode. Eu olharia l\xE1.\nJogador:
        Obrigado, seu Zeca."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[8]
      value: 'Seu Zeca: Nada. E escreve certo: aquilo ali foi falta de respeito com
        a nossa gente.'
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[9]
      value: "Seu Zeca: De nada, meu filho. E bota na sua mat\xE9ria o que \xE9 certo:
        aquilo ali n\xE3o foi briga de rua, foi falta de respeito com a nossa gente."
      objectReference: {fileID: 0}
    - target: {fileID: 2907534929357161306, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: sceneViewId
      value: 39
      objectReference: {fileID: 0}
    - target: {fileID: 6039262802136022477, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: m_LocalPosition.x
