--- !u!1001 &1418460339
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 603104586}
    m_Modifications:
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Amina:\nEssa roupa que uso n\xE3o \xE9 fantasia. \xC9 identidade. Mas
        j\xE1 me perguntaram se era 'para dan\xE7ar'."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Jogador:\nQuantas vezes sua cultura foi transformada em \u2018ex\xF3tico\u2019?"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Amina:\nIncont\xE1veis. Mas cada ponto que costuro"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Dona Marlene:\nTrabalho desde os 9 anos, levanto \xE0s 4 da manh\xE3.
        Mas j\xE1 fui chamada de \u2018baianinha fofa\u2019 por gente que nem sabe
        meu nome."
      objectReference: {fileID: 0}
    - target: {fileID: 2907534929357161306, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: sceneViewId
      value: 38
