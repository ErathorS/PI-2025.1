--- !u!1001 &2613420969945616611
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 603104586}
    m_Modifications:
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: dialogoGlobal
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: painelMontagemP1
      value: 
      objectReference: {fileID: 3114417296834192033, guid: 20c2ae482a3529741ae1fa87faf8e8cd, type: 3}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: painelMontagemP2
      value: 
      objectReference: {fileID: 7409401800855649686, guid: efd6cdd190e76ac4d8958df332f300eb, type: 3}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: ativaMontagemAcaraje
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Jogador: Voc\xEA viu a confus\xE3o?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Paulinha: Vi. Eu tava tirando foto quando os rapazes come\xE7aram a
        gritar que \u201Cisso \xE9 coisa do dem\xF4nio\u201D. Fiquei apavorada."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: 'Jogador: E as caixas?'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Paulinha: Ca\xEDram pra perto da fonte. Uma abriu no ch\xE3o. Outra
        uma mulher levou pra uma lojinha perto da Igreja do Ros\xE1rio."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: 'Jogador: Ainda podemos recuperar?'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: 'Paulinha: Acho que sim. Mas aquilo foi doloroso de ver. Racismo puro.'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: 'Jogador: Vamos contar a verdade.'
      objectReference: {fileID: 0}
    - target: {fileID: 767309303545422533, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: sceneViewId
      value: 29
      objectReference: {fileID: 0}
    - target: {fileID: 2221028148638086121, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: m_Name
      value: NPC 1
      objectReference: {fileID: 0}
    - target: {fileID: 2807461431448035721, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
