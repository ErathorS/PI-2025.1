    - target: {fileID: 2948380906371488001, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Name
      value: NPC Guia
      objectReference: {fileID: 0}
    - target: {fileID: 6649693220281678621, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: tipoExclamacao
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6649693220281678621, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: iconeExclamacao
      value: 
      objectReference: {fileID: 919132149155446097, guid: a186d2548c018924388c7f418c207f0c, type: 3}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: ehNPCIntroducao
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Ot\xE1vio:\nEi, voc\xEAs dois, a editora chefe me mandou pra garantir
        que entenderam a  proxima miss\xE3o."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Ot\xE1vio:\ndo mesmo jeito que voces fizeram da ultima vez so que agora
        em um ambiente novo."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Ot\xE1vio:\nvoc\xEAs v\xE3o entrevistar pessoas importantes, coletar
        materiais jornal\xEDsticos e ajudar a resolver casos pelo mapa. Cada hist\xF3ria
        conta."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Ot\xE1vio:\nConversem, coletem e resolvam. Mostrem que o jornal ainda
        sabe fazer jornalismo de verdade. Boa sorte, rep\xF3rteres."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Ot\xE1vio:\nAgora Pizem nas plataformas "
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Ot\xE1vio (sorrindo):\nConversem, coletem e resolvam. Mostrem que o
        jornal ainda sabe fazer jornalismo de verdade. Boa sorte, rep\xF3rteres."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: "Ricardo (suspirando):\nTrabalhar em equipe... \xF3timo."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Ot\xE1vio (sorrindo):\nConsidere isso parte do treinamento. Reportagem
        boa nasce do di\xE1logo \u2014 n\xE3o s\xF3 com as fontes, mas entre parceiros
        tamb\xE9m."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[8]
      value: "Ot\xE1vio (encerrando):\nResumindo: conversem, coletem e resolvam.
        Mostrem que o jornal ainda sabe fazer jornalismo de verdade. Boa sorte, rep\xF3rteres."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[9]
      value: "Ot\xE1vio (encerrando):\nResumindo: conversem, coletem e resolvam.
        Mostrem que o jornal ainda sabe fazer jornalismo de verdade. Boa sorte, rep\xF3rteres."
      objectReference: {fileID: 0}
    - target: {fileID: 8654470778002267675, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Size.x
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 8654470778002267675, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Size.z
      value: 5
      objectReference: {fileID: 0}
