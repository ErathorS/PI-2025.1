--- !u!1001 &1199927742
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1553491431}
    m_Modifications:
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Jogador: Seu restaurante foi afetado pelo apag\xE3o?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Gustavo: Nada. E ainda bem \u2014 preju\xEDzo seria enorme."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: Mas v\xE1rios bairros perif\xE9ricos est\xE3o sem luz h\xE1
        mais de 24h."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Gustavo: Isso \xE9 infraestrutura, n\xE3o \u201Cpreconceito\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Jogador: Alguns dizem que h\xE1 prioridade para \xE1reas nobres."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Gustavo: Claro que h\xE1. Aqui o consumo \xE9 maior, o com\xE9rcio
        \xE9 essencial. L\xF3gica econ\xF4mica."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: "Jogador: Isso n\xE3o refor\xE7a desigualdades?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Gustavo: O mundo nunca foi justo. Cada um corre atr\xE1s. Quem espera
        governo continua no escuro."
      objectReference: {fileID: 0}
    - target: {fileID: 767309303545422533, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: sceneViewId
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 2221028148638086121, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: m_Name
