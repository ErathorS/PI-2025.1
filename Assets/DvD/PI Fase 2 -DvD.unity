--- !u!1001 &901488088
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 652979185}
    m_Modifications:
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: 'Jogador: Precisa ligar dois pontos ao mesmo tempo?'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Nanda: Sim. Tentamos hoje, mas sem avisar o outro lado a tempo, n\xE3o
        funcionou."
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: Ent\xE3o \xE9 quase simult\xE2neo?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: 'Nanda: Isso. Um painel inicia um contador; o outro precisa ativar antes
        dele acabar.'
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Jogador: D\xE1 pra combinar?"
      objectReference: {fileID: 0}
    - target: {fileID: 518007960451841433, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Nanda: D\xE1, mas tem que ser preciso. Fala pro pessoal de l\xE1 ficar
        atento s\xF3 acende se for junto."
      objectReference: {fileID: 0}
    - target: {fileID: 767309303545422533, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
      propertyPath: sceneViewId
      value: 21
      objectReference: {fileID: 0}
    - target: {fileID: 2221028148638086121, guid: 2d7b93edaa776914794682e1b44a0cde, type: 3}
