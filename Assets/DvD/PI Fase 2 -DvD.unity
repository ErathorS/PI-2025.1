      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 2258125217435752391, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: sceneViewId
      value: 22
      objectReference: {fileID: 0}
    - target: {fileID: 2948380906371488001, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: m_Name
      value: NPC 3 (7)
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: 'Jogador: Preciso entender como consertar o sistema.'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Seu Arlindo: O circuito \xE9 dividido: metade depende de l\xE1, metade
        daqui."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: Se eu ligar s\xF3 um lado, resolve?"
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Seu Arlindo: N\xE3o. Se ligar um sem o outro, trava tudo. Tem que sincronizar
        como dupla de forr\xF3 entrando no mesmo compasso."
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: 'Jogador: E se errar o tempo?'
      objectReference: {fileID: 0}
    - target: {fileID: 7660439255949543271, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: 'Seu Arlindo: Apaga tudo de novo. Tem poucos segundos pra acionar o
        outro lado.'
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1b8a6df0a5d7e1645affd635052f95b4, type: 3}
