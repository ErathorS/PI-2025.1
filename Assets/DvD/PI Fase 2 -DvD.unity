--- !u!1001 &686980611
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 415652084}
    m_Modifications:
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[0]
      value: "Jogador: Sabe o que causou o apag\xE3o?"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[1]
      value: "Diguinho: Deve ter sido a gente mesmo\u2026 aqui tudo \xE9 meio improvisado."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: E achar justo que a parte rica tenha luz e voc\xEAs n\xE3o?"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[3]
      value: "Diguinho: Justo n\xE3o \xE9, mas eles pagam mais."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[4]
      value: "Jogador: Ent\xE3o a culpa \xE9 do bairro?"
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[5]
      value: "Diguinho: Se fosse diferente, j\xE1 tinham resolvido. A gente acostuma."
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[6]
      value: 'Jogador: E se pudesse ser mais justo?'
      objectReference: {fileID: 0}
    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[7]
      value: "Diguinho: Seria lindo. Eu s\xF3 queria ver o jogo na TV."
      objectReference: {fileID: 0}
    - target: {fileID: 2907534929357161306, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: sceneViewId
      value: 40
      objectReference: {fileID: 0}
