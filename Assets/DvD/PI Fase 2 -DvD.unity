    - target: {fileID: 2755968028323320779, guid: 6738dc292f498434ea47b4df3cb1a52c, type: 3}
      propertyPath: linhasDialogo.Array.data[2]
      value: "Jogador: A empresa deu explica\xE7\xE3o?"
